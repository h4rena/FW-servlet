<web-app xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd" version="5.0">
<display-name>Framework-servlet</display-name>
<servlet>
<servlet-name>FrontControllerServlet</servlet-name>
<servlet-class>main.java.tacos.FrontControllerServlet</servlet-class>
</servlet>
<servlet-mapping>
<servlet-name>FrontControllerServlet</servlet-name>
<url-pattern>/url/*</url-pattern>
</servlet-mapping>
<listener>
<listener-class>main.java.utils.AppListener</listener-class>
</listener>
</web-app>